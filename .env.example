# DeepSeek 官方 API 密钥（直连官方时必填）
VITE_DEEPSEEK_API_KEY=your_api_key_here

# DeepSeek 官方 API 地址（可选，默认 https://api.deepseek.com）
VITE_DEEPSEEK_OFFICIAL_URL=https://api.deepseek.com

# DeepSeek 模型（可选，默认 deepseek-chat）
VITE_DEEPSEEK_MODEL=deepseek-chat

# 自定义后端地址（高级：如果你自建了 /parse、/analyze、/practice 端点）
VITE_DEEPSEEK_API_URL=https://your-deepseek-endpoint.example.com
